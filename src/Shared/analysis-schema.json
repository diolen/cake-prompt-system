{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CakeAnalyzerOutputSchema",
  "type": "object",
  "required": ["system_meta", "task_context", "metrics", "relations", "impacted_by"],
  "additionalProperties": false,
  "properties": {
    "system_meta": {
      "type": "object",
      "required": ["framework", "framework_version", "php_version"],
      "properties": {
        "framework": { "type": "string" },
        "framework_version": { "type": "string", "enum": ["v2", "v3", "v4"] },
        "php_version": { "type": "string" }
      }
    },
    "task_context": {
      "type": "object",
      "required": ["target_layer", "file_path", "class_name"],
      "properties": {
        "target_layer": { "type": "string", "enum": ["Controller", "Model", "View", "Unknown"] },
        "file_path": { "type": "string" },
        "class_name": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["connectivity", "influence_score"],
      "properties": {
        "connectivity": { "type": "integer", "minimum": 0 },
        "influence_score": { "type": "integer", "minimum": 0 }
      }
    },
    "relations": {
      "type": "object",
      "required": ["models", "components", "associations", "validate", "helpers", "elements", "variables", "controller_name"],
      "properties": {
        "models": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "validate": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 0
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": { "type": ["string", "array"] },
                    "message": { "type": "string" },
                    "required": { "type": ["boolean", "string"] },
                    "allowEmpty": { "type": "boolean" },
                    "on": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            }
          ]
        },
        "helpers": { "type": "array", "items": { "type": "string" } },
        "elements": { "type": "array", "items": { "type": "string" } },
        "element_context": { "type": "object", "additionalProperties": { "type": "object" }, "default": {} },
        "variables": { "type": "array", "items": { "type": "string" } },
        "controller_name": { "type": "string" },
        "associations": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 0
            },
            {
              "type": "object",
              "required": ["belongsTo", "hasMany", "hasOne", "hasAndBelongsToMany"],
              "additionalProperties": false,
              "properties": {
                "belongsTo": {
                  "oneOf": [
                    { "type": "array", "maxItems": 0 },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["className", "foreignKey", "dependent"],
                        "properties": {
                          "className": { "type": "string" },
                          "foreignKey": { "type": "string" },
                          "dependent": { "type": "boolean" }
                        }
                      }
                    }
                  ]
                },
                "hasMany": {
                  "oneOf": [
                    { "type": "array", "maxItems": 0 },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["className", "foreignKey", "dependent"],
                        "properties": {
                          "className": { "type": "string" },
                          "foreignKey": { "type": "string" },
                          "dependent": { "type": "boolean" }
                        }
                      }
                    }
                  ]
                },
                "hasOne": {
                  "oneOf": [
                    { "type": "array", "maxItems": 0 },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["className", "foreignKey", "dependent"],
                        "properties": {
                          "className": { "type": "string" },
                          "foreignKey": { "type": "string" },
                          "dependent": { "type": "boolean" }
                        }
                      }
                    }
                  ]
                },
                "hasAndBelongsToMany": {
                  "oneOf": [
                    { "type": "array", "maxItems": 0 },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["className", "foreignKey", "dependent"],
                        "properties": {
                          "className": { "type": "string" },
                          "foreignKey": { "type": "string" },
                          "dependent": { "type": "boolean" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "impacted_by": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}